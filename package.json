{
  "name": "simply-sub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm -w apps/web run start",
    "build": "npm -w apps/web run build",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "vite": "8.3.5"
  },
  "volta": {
    "node": "24.19.0",
    "npm": "12.0.2"
  }
}

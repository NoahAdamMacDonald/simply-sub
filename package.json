    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "vite": "8.3.5"
  },
  "volta": {
    "node": "24.19.0",
    "npm": "12.0.2"
  }
}

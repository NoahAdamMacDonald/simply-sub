{
  "name": "simply-sub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm -w apps/web run start",
    "dev:api": "npm -w apps/api run dev",
    "build": "npm -w packages/core run typecheck && tsc -p scripts && npm run data:build && npm -w apps/web run build && npm -w apps/api run build && npm -w apps/bot run build",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && stylelint \"**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:schema": "tsx scripts/generate-json-schema.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:ids": "tsx scripts/check-ids.ts",
    "data:build": "tsx scripts/build-catalog.ts",
    "data:icons": "tsx scripts/fetch-icons.ts",
    "app:icons": "tsx scripts/app-icons.ts",
    "data:queue": "tsx scripts/discover-services.ts",
    "data:urls": "tsx scripts/find-urls.ts",
    "data:render": "tsx scripts/render-pages.ts",
    "data:extract": "tsx scripts/extract-plans.ts",
    "data:batch": "tsx scripts/batch-pr.ts",
    "data:baselines": "tsx scripts/save-baselines.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "playwright-core": "1.64.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sharp": "0.35.5",
    "stylelint": "^17.16.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vite": "8.3.5",
    "undici": "7.30.1",
    "zod": "4.6.6",
    "exceljs": {
      "uuid": "14.0.3"
    }
  },
  "volta": {
    "node": "24.22.1",
    "npm": "12.0.2"
  }
}

/* Repo scripts (scripts/*.ts) run on Node through tsx, which strips types without checking them, so */
/* `npm run build` type-checks them with this config. */
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["."]
}

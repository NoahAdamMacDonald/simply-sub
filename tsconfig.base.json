/* Shared TypeScript settings for every workspace (apps/*, packages/*, scripts). */
/* Each workspace's tsconfig.json extends this file and adds only what it needs (lib, types, framework options). */
{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "target": "ES2022",
    "module": "preserve",
    /* Shared packages are imported as TypeScript source, with no build step. Without baseUrl */
    /* (deprecated in TS 6), these paths are relative to this file. */
    "paths": {
      "@simply-sub/core": ["./packages/core/src/index.ts"]
    }
  }
}

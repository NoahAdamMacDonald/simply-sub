// The "simply-sub-bot" Worker (BLUEPRINT §6.4, §6.5, §7.7; M8.3, M3.9 to M3.11). A cron trigger starts a Workflow that
// checks the catalog's pages against their baselines, step by step, builds the weekly "Catalog digest" pull request,
// and on data/automation.yaml's discovery cadence drafts the next queued services into a batch pull request, all
// through the GitHub REST API. It never merges, and it never writes to the catalog: Git is the source of truth.
// Not deployed by Workers Builds: deploying it and its secrets (GITHUB_TOKEN; the search's TAVILY_API_KEY,
// BRAVE_API_KEY and SEARXNG_URL, each optional) are the project owner's to do.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "simply-sub-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // @cloudflare/playwright, for Browser Rendering, needs Node's APIs.
  "compatibility_flags": ["nodejs_compat"],
  // 03:00 UTC every night.
  "triggers": { "crons": ["0 3 * * *"] },
  // One instance a night, named for the date: a step per provider and per bundle, each retried, then the pull request.
  "workflows": [
    { "name": "simply-sub-price-check", "binding": "PRICE_CHECK", "class_name": "PriceCheck" },
  ],
  // Workers AI reads a price off a changed page, reviews the digest, and extracts new services (10,000 Neurons a day on
  // the free plan; data/automation.yaml's batch.neurons is the night's share).
  "ai": { "binding": "AI" },
  // Browser Rendering, only for pages whose text a plain fetch doesn't get (10 browser-minutes a day on the free plan).
  "browser": { "binding": "BROWSER" },
  // The catalog as deployed (BLUEPRINT §5.3), for its prices and their sources. The bot only reads it: D1 has no
  // read-only binding, so every query goes through src/catalog.ts, which runs SELECTs only.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simply-sub-catalog",
      "database_id": "bddf9622-ec55-4c38-8fb7-350a16f98fb2",
    },
  ],
  // What the bot remembers between nights (M3.9): check dates and each changed page's findings, under keys that start
  // with bot:, in the API's namespace (simply-sub-kv), so no new resource is needed. A few writes a night of 1,000 a day.
  "kv_namespaces": [{ "binding": "KV", "id": "a1507dd46d40411d8af62a85614db96c" }],
  // The repository the pull request goes to. GITHUB_TOKEN is a secret: a fine-grained token for this repository only,
  // with Contents and Pull requests read and write (`wrangler secret put GITHUB_TOKEN`).
  "vars": { "GITHUB_REPOSITORY": "NoahAdamMacDonald/simply-sub", "GITHUB_BASE": "main" },
  // No public URL: it has nothing to serve.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}

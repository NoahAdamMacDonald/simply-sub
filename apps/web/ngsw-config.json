{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationRequestStrategy": "freshness",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/*.webmanifest",
          "/app-icons/**",
          "/*.css",
          "/*.js",
          "!/ngsw-worker.js",
          "!/safety-worker.js",
          "!/worker-basic.min.js"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "icons",
      "urls": ["/icons/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxSize": 1000,
        "maxAge": "30d"
      }
    }
  ]
}

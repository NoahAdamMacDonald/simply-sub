// The "simply-sub" Worker: the app's static files plus the catalog API (BLUEPRINT §2, §7.4).
// Workers Builds deploys it on every push to main (BLUEPRINT §7.6).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "simply-sub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Filled by scripts/copy-web-build.mjs: the app under simply/sub/, plus a root index.html for
    // the SPA fallback (BLUEPRINT §7.3).
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API paths invoke the Worker. Everything else is a static file, which costs no quota.
    "run_worker_first": ["/api/*"],
  },
  // The catalog cache (BLUEPRINT §5.3), in Eastern North America. The id isn't a secret: using it
  // needs your Cloudflare login. Apply migrations with `npm run db:migrate:local` / `:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simply-sub-catalog",
      "database_id": "bddf9622-ec55-4c38-8fb7-350a16f98fb2",
      "migrations_dir": "migrations",
    },
  ],
  // Only these two paths of simplely.ca belong to this Worker; the rest of the domain stays free for
  // other projects. A route needs a proxied DNS record for the hostname (the AAAA 100:: placeholder).
  "routes": [
    { "pattern": "simplely.ca/simply/sub*", "zone_name": "simplely.ca" },
    { "pattern": "simplely.ca/api/sub*", "zone_name": "simplely.ca" },
  ],
  // Production lives only on simplely.ca. Non-main branch builds still get a preview link on
  // workers.dev (public but unguessable; Cloudflare Access can lock them).
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
}

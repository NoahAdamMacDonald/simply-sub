{
  "name": "@simply-sub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-web-build.mjs --optional && wrangler dev",
    "build": "node scripts/copy-web-build.mjs && npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types --check && tsc",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply simply-sub-catalog --local",
    "db:migrate:remote": "wrangler d1 migrations apply simply-sub-catalog --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}

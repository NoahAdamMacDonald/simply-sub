# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.
# Patterns without a leading slash match in every workspace (apps/*, packages/*).

# Dependencies
node_modules/

# Build output
dist/
tmp/
out-tsc/
*.tsbuildinfo
.angular/

# Cloudflare Worker: local state, secrets and the web build copied in at build time.
# apps/api/public/_headers stays tracked (BLUEPRINT §7.6).
.wrangler/
.dev.vars*
!.dev.vars.example
apps/api/public/simply/
apps/api/public/index.html

# The catalog snapshot and the provider icons, built from data/ by `npm run data:build` (BLUEPRINT §6.3).
apps/web/public/data/
apps/web/public/icons/

# Environment
.env
.env.*
!.env.example

# Tests
coverage/
test-results/
playwright-report/
__screenshots__/

# Logs and caches
*.log
.eslintcache
.sass-cache/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Claude Code personal settings
.claude/settings.local.json

# Local-only planning material (kept out of the public repo)
docs/drafts/
docs/wireframes/

# System files
.DS_Store
Thumbs.db
